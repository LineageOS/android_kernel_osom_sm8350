#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any OSOM-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# you can check the .config file to verify that your configuration option is
# being set as expected.
#

# DTB
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Console
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_SERIAL_MSM_GENI_EARLY_CONSOLE=y

# EDL
# CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE_DEFAULT is not set
CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE_FORCE_WARM_RESET=y

# Fingerprint
CONFIG_GOODIX_FINGERPRINT=m
CONFIG_BETTERLIFE_FINGERPRINT=m

# ICNSS2
# CONFIG_ICNSS2 is not set
# CONFIG_ICNSS2_QMI is not set

# NFC
CONFIG_NFC_ST21NFC=m
CONFIG_ESE_ST54J=m

# Platform
CONFIG_MACH_OSOM_PYRITE=y

# UVC
CONFIG_USB_CONFIGFS_F_UVC=m

# UWB
CONFIG_DW3000=m
CONFIG_6LOWPAN=m
CONFIG_IEEE802154=m
CONFIG_IEEE802154_NL802154_EXPERIMENTAL=y
CONFIG_IEEE802154_6LOWPAN=m
CONFIG_MAC802154=m
CONFIG_MCPS802154=m
CONFIG_MCPS802154_REGION_FIRA=m
CONFIG_MCPS802154_REGION_NFCC_COEX=m

# Wi-Fi
CONFIG_QCA_CLD_WLAN=m
CONFIG_CNSS_QCA6490=y
